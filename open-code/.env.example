# Copy to .env (never commit it) and `chmod 600 .env`.
# Generate the identity values on the target host with:
#   printf 'HOST_USER=%s\nHOST_UID=%s\nHOST_GID=%s\nHOST_HOME=%s\n' "$USER" "$(id -u)" "$(id -g)" "$HOME"

# --- runtime user (created by entrypoint.sh, must match the host) ---
HOST_USER=ptaq
HOST_UID=1000
HOST_GID=1000
HOST_HOME=/home/ptaq

# Directory with all projects; mounted at the same path. Default: $HOST_HOME/Projects
#PROJECTS_DIR=/home/ptaq/Projects

# Private key for the agent (the .pub next to it is mounted too)
AGENT_SSH_KEY=/home/ptaq/.ssh/ptaq-agent

# --- server ---
# 0.0.0.0 = all interfaces (needed for VPN/mobile access). Restrict with a
# firewall rule to the VPN subnet if the host has a public interface.
# 127.0.0.1 = only via SSH tunnel (`oc2 connect <host>`).
BIND_IP=0.0.0.0
PORT=4096
# Long random value, e.g. `openssl rand -base64 32`
OPENCODE_SERVER_PASSWORD=

# --- secrets referenced from opencode.json as {env:NAME} ---
EXA_API_KEY=
FIGMA_CLIENT_SECRET=
