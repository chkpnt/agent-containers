#!/usr/bin/env bash
# OpenCode v1 launcher (legacy). Uses the frozen image tag open-code:v1
# (create it once with: docker tag open-code open-code:v1).
# Adjust the extra /tmp/* mounts below to your machine.

PROJ="$(basename "$(pwd)")"
NAME="open-code-${PROJ}"

exec docker run --rm --tty --interactive \
  --name "$NAME" \
  --network=host \
  --gpus all \
  --add-host=host.docker.internal:host-gateway \
  -v "$HOME/.local/state/opencode:/home/node/.local/state/opencode" \
  -v "$HOME/.local/share/opencode:/home/node/.local/share/opencode" \
  -v "$HOME/.config/opencode:/home/node/.config/opencode" \
  -v "$HOME/.cache/opencode:/home/node/.cache/opencode" \
  -v "$HOME/.ssh/ptaq-agent:/home/node/.ssh/id_ed25519" \
  -v "$HOME/.ssh/ptaq-agent.pub:/home/node/.ssh/id_ed25519.pub" \
  -v "$HOME/.claude:/home/node/.claude" \
  -v "$HOME/.config/gh:/home/node/.config/gh" \
  -v "$(pwd):/app:rw" \
  -v "/home/ptaq/Projects/oss/rust-stemmers:/tmp/rust-stemmers:rw" \
  -v "/home/ptaq/Projects/oss/tantivy:/tmp/tantivy" \
  -v "/home/ptaq/Projects/oss/milvus-docs:/tmp/milvus-docs:rw" \
  -v "/home/ptaq/Projects/datera/absint:/tmp/absint" \
  -v "/home/ptaq/Projects/oss/docling:/tmp/docling" \
  -v "/home/ptaq/Projects/datera/datera-bruno-endpoints:/tmp/datera-bruno-endpoints" \
  -v "/home/ptaq/Projects/oss/docling-serve:/tmp/docling-serve" \
  -v "/home/ptaq/Projects/oss/neural-search:/tmp/neural-search" \
  -v "/home/ptaq/Projects/oss/ml-commons:/tmp/ml-commons" \
  -v "/home/ptaq/.config/nvim/nvchad:/tmp/nvchad" \
  open-code:v1 opencode "$@"
