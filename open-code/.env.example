# Copy to .env (never commit it) and `chmod 600 .env`.
# Generate the identity values on the target host with:
#   printf 'HOST_USER=%s\nHOST_UID=%s\nHOST_GID=%s\nHOST_HOME=%s\n' "$USER" "$(id -u)" "$(id -g)" "$HOME"

# --- runtime user (created by entrypoint.sh, must match the host) ---
HOST_USER=ptaq
HOST_UID=1000
HOST_GID=1000
HOST_HOME=/home/ptaq

# Directory with all projects; mounted at the same path. Default: $HOST_HOME/Projects
#PROJECTS_DIR=/home/ptaq/Projects

# Private key for the agent (the .pub next to it is mounted too)
AGENT_SSH_KEY=/home/ptaq/.ssh/ptaq-agent

# Directory with extra CA certificates (*.crt / *.pem, one CA per file), e.g.
# the Datera internal CA. Default: ./ca-certificates next to this file.
#AGENT_CA_DIR=/home/ptaq/.config/agent-ca

# --- server ---
# 127.0.0.1 = only via Caddy (HTTPS) or SSH tunnel (`oc2 connect <host>`).
# 0.0.0.0 = plain HTTP on all interfaces; firewall it to the VPN.
BIND_IP=127.0.0.1
PORT=4096
# Long random value, e.g. `openssl rand -base64 32`
# (clients use the same value as OPENCODE_PASSWORD)
OPENCODE_SERVER_PASSWORD=

# --- HTTPS (Caddy) ---
HTTPS_PORT=4443
# certificate (append the CA cert if clients complain about the chain) + key
TLS_CERT=/etc/ssl/datera/wildcard.datera.internal.crt
TLS_KEY=/etc/ssl/datera/wildcard.datera.internal.key

# --- secrets referenced from opencode.json as {env:NAME} ---
EXA_API_KEY=
FIGMA_CLIENT_SECRET=

# --- agent workflows (`workflows` profile, see README) ---
#COMPOSE_PROFILES=gpu,workflows
# hostname covered by TLS_CERT; used for the dashboard/ntfy/session links
PUBLIC_HOST=
HATCHET_HTTPS_PORT=4444
NTFY_HTTPS_PORT=4445
HATCHET_DB_PASSWORD=
HATCHET_ADMIN_EMAIL=admin@example.com
HATCHET_ADMIN_PASSWORD=
# `hatchet-admin token create ...` after the first start
HATCHET_CLIENT_TOKEN=
NTFY_USER=agent
# your ntfy app login; the server only reads the hash
NTFY_PASSWORD=
# `ntfy user hash`, keep the single quotes (bcrypt contains $)
NTFY_PASSWORD_HASH=''
# tk_ + 29 chars
NTFY_TOKEN=
NTFY_TOPIC=agent-workflows
# project checkout the worker runs (`pnpm wf worker`) from
WF_WORKER_DIR=
