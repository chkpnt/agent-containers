# agent-base:v2 — user-agnostic base image.
#
# Differences to base/Dockerfile (v1, still used by claude-code / openai-codex):
#   * ubuntu:26.04 + git-core PPA (newest stable git, relative worktrees >= 2.48)
#   * nothing user-specific is baked in: no HOST_UID/HOST_GID build args, all
#     tools live in system paths (/usr/local, /opt). The runtime user is created
#     by entrypoint.sh from HOST_USER/HOST_UID/HOST_GID/HOST_HOME, so host paths
#     (projects, pnpm store, opencode dirs) can be mounted at the SAME absolute
#     path as on the host.
FROM node:26 AS node

FROM ubuntu:26.04

ARG TARGETARCH
ARG DEBIAN_FRONTEND=noninteractive
# Single source of truth for apt-installed tooling. Override per-build with:
#   docker build --build-arg LOCAL_TOOLS="..." -f base/Dockerfile.v2 base
ARG LOCAL_TOOLS="curl jq ripgrep vim nano make zip unzip openssh-client wget tree imagemagick ffmpeg ca-certificates gnupg procps build-essential python3 python3-pip python3-venv redis-tools less file git-lfs libnss3-tools"
# Hosts whose SSH keys are trusted system-wide (scanned at build time).
ARG SSH_KNOWN_HOSTS="github.com bitbucket.org ssh.bitbucket.org"

# 1. System packages. git comes from the official git-core PPA (newer than the
#    distro's), installed in the same layer.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends software-properties-common gpg-agent; \
    add-apt-repository -y ppa:git-core/ppa; \
    apt-get update; \
    apt-get install -y --no-install-recommends git ${LOCAL_TOOLS}; \
    rm -rf /var/lib/apt/lists/*; \
    git --version; \
    git lfs install --system --skip-repo

# ubuntu images ship an 'ubuntu' user with uid/gid 1000, which would collide
# with the most common host uid. entrypoint.sh creates the real user at runtime.
RUN if id ubuntu >/dev/null 2>&1; then userdel -r ubuntu 2>/dev/null || userdel ubuntu; fi; \
    if getent group ubuntu >/dev/null; then groupdel ubuntu; fi

# 2. Node.js from the official image (independent of Ubuntu's node package).
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=node /usr/local/include/node /usr/local/include/node
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    node --version && npm --version

# Corepack (no longer bundled with Node since v25) -> pnpm/yarn shims in /usr/local/bin
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN npm install -g corepack && corepack enable

# 3. gh CLI (official apt repo)
RUN set -eux; \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg; \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list; \
    apt-get update; apt-get install -y --no-install-recommends gh; \
    rm -rf /var/lib/apt/lists/*

# 4. Static binaries copied from official images.
COPY --from=oven/bun:1 /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx
# Pinned: bump deliberately (https://github.com/grafana/k6/releases).
COPY --from=grafana/k6:2.3.0 /usr/bin/k6 /usr/local/bin/k6
# Pinned: bump deliberately (https://github.com/astral-sh/uv/releases).
COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /uvx /usr/local/bin/
RUN k6 version && uv --version && bun --version
# Docker CLI + compose/buildx plugins for the host daemon (docker.sock mount).
# Pinned major: bump deliberately (https://hub.docker.com/_/docker).
COPY --from=docker:29-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:29-cli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins
RUN docker --version && docker compose version && docker buildx version

# 5. Chromium (Playwright build) + its system deps, in a system-wide location.
#    Playwright supports linux x64 and arm64, so one code path for both arches.
#    If install-deps rejects this Ubuntu release, pin PLAYWRIGHT_HOST_PLATFORM
#    (e.g. ubuntu24.04-x64) or list the libraries manually.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN set -eux; \
    apt-get update; \
    npx -y playwright@latest install --with-deps chromium; \
    rm -rf /var/lib/apt/lists/* /root/.npm; \
    chmod -R a+rX /opt/ms-playwright; \
    chrome="$(find /opt/ms-playwright -type f -name chrome -path '*/chrome-linux*/chrome' | sort -V | tail -n 1)"; \
    test -n "$chrome"; \
    ln -sf "$chrome" /usr/local/bin/chromium; \
    chromium --version

# agent-browser finds `chromium` on PATH; be explicit anyway.
ENV AGENT_BROWSER_EXECUTABLE_PATH=/usr/local/bin/chromium
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/local/bin/chromium
ENV K6_BROWSER_EXECUTABLE_PATH=/usr/local/bin/chromium
ENV K6_BROWSER_HEADLESS=true
# Same as grafana/k6:with-browser: no-sandbox avoids needing SYS_ADMIN
ENV K6_BROWSER_ARGS=no-sandbox

# 6. Global npm CLIs (system-wide, root-owned -> not modifiable by the agent)
RUN npm install -g agent-browser && rm -rf /root/.npm

# 7. gh extensions. gh only discovers extensions in the per-user data dir
#    (~/.local/share/gh/extensions), so they are staged in /opt and symlinked
#    by entrypoint.sh. Downloaded directly because `gh extension install`
#    requires auth even for public repos (cli/cli#2680).
RUN set -eux; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$arch" in \
      amd64|arm64) asset="linux-$arch" ;; \
      *) echo "gh-stack: unsupported arch $arch" >&2; exit 1 ;; \
    esac; \
    url="https://github.com/github/gh-stack/releases/latest/download/$asset"; \
    tag="$(curl -fsS -o /dev/null -w '%{redirect_url}' "$url" | sed -n 's#.*/download/\([^/]*\)/.*#\1#p')"; \
    test -n "$tag"; \
    dir=/opt/gh-extensions/gh-stack; \
    mkdir -p "$dir"; \
    curl -fsSL -o "$dir/gh-stack" "$url"; \
    chmod 755 "$dir/gh-stack"; \
    printf 'owner: github\nname: gh-stack\nhost: github.com\ntag: %s\nispinned: false\npath: %s/gh-stack\n' \
      "$tag" "$dir" > "$dir/manifest.yml"; \
    "$dir/gh-stack" --help > /dev/null

# 8. System-wide SSH/git defaults (per-user files are not needed)
RUN set -eux; \
    ssh-keyscan -t ed25519,rsa,ecdsa ${SSH_KNOWN_HOSTS} > /etc/ssh/ssh_known_hosts 2>/dev/null; \
    for h in ${SSH_KNOWN_HOSTS}; do ssh-keygen -F "$h" -f /etc/ssh/ssh_known_hosts >/dev/null; done; \
    chmod 644 /etc/ssh/ssh_known_hosts; \
    git config --system safe.directory '*'
# Not enabled: worktree.useRelativePaths sets extensions.relativeWorktrees in
# the repo, which host git < 2.48 refuses to read. Same-path mounts make
# absolute worktree paths valid on host and in the container anyway.

# 9. Shell + pnpm defaults (entrypoint.sh copies the pnpm template on first run)
COPY ./.bash_aliases /etc/agent/bash_aliases
COPY ./pnpm-config.yaml /etc/agent/pnpm-config.yaml
RUN echo '[ -f /etc/agent/bash_aliases ] && . /etc/agent/bash_aliases' >> /etc/bash.bashrc

# uv: project dirs and ~/.cache/uv are different mounts -> hardlinks fail.
ENV UV_LINK_MODE=copy

COPY ./entrypoint.sh /usr/local/bin/entrypoint.sh
# Build-time tool runs leave root-owned dirs in /tmp (node-compile-cache, ...)
# that the runtime user then cannot create.
RUN chmod 755 /usr/local/bin/entrypoint.sh && rm -rf /tmp/* /tmp/.[!.]*

# Container starts as root; entrypoint.sh drops to the host user.
WORKDIR /
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]
