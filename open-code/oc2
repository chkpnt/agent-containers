#!/usr/bin/env bash
# OpenCode v2 launcher (image open-code:v2).
#
#   oc2 [--gpu] [opencode args...]       local TUI in $PWD, private (--standalone) server
#   oc2 shell [--gpu]                    bash in the same container setup
#   oc2 remote <url> [opencode args...]  TUI against a running server (e.g. over VPN)
#   oc2 connect <ssh-host> [port]        shared SSH tunnel to a server bound to 127.0.0.1, then TUI
#   oc2 disconnect <ssh-host>            close that tunnel
#
# Every path is mounted at the same absolute path as on the host (see README).
# Per-machine settings go to ${XDG_CONFIG_HOME:-~/.config}/oc2.env (sourced):
#   OC2_IMAGE=open-code:v2
#   OC2_PROJECTS=$HOME/Projects
#   OC2_SSH_KEY=$HOME/.ssh/ptaq-agent           # .pub next to it is mounted too
#   OC2_EXTRA_MOUNTS=($HOME/.config/nvim/nvchad) # bash array, same-path mounts
#   OC2_CA_DIR=$HOME/.config/agent-ca            # extra CAs (*.crt/*.pem) to trust
#   OC2_LOCAL_PORT=14096                         # first local port tried by `oc2 connect`
#   OPENCODE_PASSWORD=...                        # for remote/connect
set -euo pipefail

CFG="${XDG_CONFIG_HOME:-$HOME/.config}/oc2.env"
# shellcheck source=/dev/null
[ -f "$CFG" ] && . "$CFG"

OC2_IMAGE="${OC2_IMAGE:-open-code:v2}"
OC2_PROJECTS="${OC2_PROJECTS:-$HOME/Projects}"
OC2_SSH_KEY="${OC2_SSH_KEY:-}"
OC2_LOCAL_PORT="${OC2_LOCAL_PORT:-14096}"
if ! declare -p OC2_EXTRA_MOUNTS >/dev/null 2>&1; then OC2_EXTRA_MOUNTS=(); fi

die() { echo "oc2: $*" >&2; exit 1; }

ARGS=(
  --rm --interactive --tty
  --init
  --network=host
  -e HOST_USER="$(id -un)" -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)" -e HOST_HOME="$HOME"
)
# v2 client reads OPENCODE_PASSWORD, `opencode serve` OPENCODE_SERVER_PASSWORD
pw="${OPENCODE_PASSWORD:-${OPENCODE_SERVER_PASSWORD:-}}"
if [ -n "$pw" ]; then
  export OPENCODE_PASSWORD="$pw" OPENCODE_SERVER_PASSWORD="$pw"
  ARGS+=(-e OPENCODE_PASSWORD -e OPENCODE_SERVER_PASSWORD)
fi
for v in EXA_API_KEY FIGMA_CLIENT_SECRET; do
  [ -n "${!v:-}" ] && ARGS+=(-e "$v")
done

MOUNTED=()
# mount <host-path> [ro]: same path inside; skipped if missing so docker does
# not create root-owned dirs on the host.
mount_same() {
  [ -e "$1" ] || { echo "oc2: skip missing $1" >&2; return 0; }
  ARGS+=(-v "$1:$1${2:+:$2}")
  MOUNTED+=("$1")
}

# opencode v2 dirs: host *-v2 copies at the default paths (see migrate-v2.sh)
for d in .config/opencode .local/share/opencode .local/state/opencode .cache/opencode; do
  mkdir -p "$HOME/$d-v2"
  ARGS+=(-v "$HOME/$d-v2:$HOME/$d")
done

mount_same "$OC2_PROJECTS"
mkdir -p "$HOME/.local/share/pnpm"   # shared pnpm store; must persist on the host
mount_same "$HOME/.local/share/pnpm"
mount_same "$HOME/.claude"
mount_same "$HOME/.config/gh"
if [ -n "$OC2_SSH_KEY" ]; then
  [ -f "$OC2_SSH_KEY" ] || die "OC2_SSH_KEY=$OC2_SSH_KEY not found"
  ARGS+=(-v "$OC2_SSH_KEY:$HOME/.ssh/id_ed25519:ro")
  [ -f "$OC2_SSH_KEY.pub" ] && ARGS+=(-v "$OC2_SSH_KEY.pub:$HOME/.ssh/id_ed25519.pub:ro")
fi
for m in "${OC2_EXTRA_MOUNTS[@]}"; do mount_same "$m"; done
if [ -n "${OC2_CA_DIR:-}" ]; then
  [ -d "$OC2_CA_DIR" ] || die "OC2_CA_DIR=$OC2_CA_DIR not found"
  ARGS+=(-v "$OC2_CA_DIR:/etc/agent/ca-certificates:ro")
fi

# Working directory: $PWD, mounted on its own if not covered already.
PWD_REAL="$(pwd -P)"
covered=false
for m in "${MOUNTED[@]}"; do
  case "$PWD_REAL/" in "$m"/*) covered=true; break ;; esac
done
$covered || mount_same "$PWD_REAL"
ARGS+=(-w "$PWD_REAL")

GPU=false
if [ "${1:-}" = "--gpu" ]; then GPU=true; shift; fi
$GPU && ARGS+=(--gpus all)

PROJ="$(basename "$PWD_REAL")"
run() { docker run --name "oc2-${PROJ}-$$" "${ARGS[@]}" "$OC2_IMAGE" "$@"; }

# Shared SSH tunnels: one ssh master per host, kept after the client exits so
# several clients can use it; closed with `oc2 disconnect <host>`.
TUNNEL_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oc2"
tunnel_paths() {
  local id="${1//[^A-Za-z0-9._@-]/_}"
  SOCK="$TUNNEL_DIR/ssh-$id.sock"
  PORTFILE="$TUNNEL_DIR/ssh-$id.port"
}
tunnel_up() {
  tunnel_paths "$1"
  [ -S "$SOCK" ] && [ -s "$PORTFILE" ] && ssh -S "$SOCK" -O check "$1" 2>/dev/null
}
port_busy() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
tunnel_start() {
  local host="$1" rport="$2" lport="$OC2_LOCAL_PORT"
  tunnel_paths "$host"
  mkdir -p "$TUNNEL_DIR"
  rm -f "$SOCK" "$PORTFILE"
  # first free local port from OC2_LOCAL_PORT up, so several hosts can be connected
  while port_busy "$lport"; do
    lport=$((lport + 1))
    [ "$lport" -lt $((OC2_LOCAL_PORT + 100)) ] || die "no free local port near $OC2_LOCAL_PORT"
  done
  ssh -f -N -M -S "$SOCK" -o ExitOnForwardFailure=yes \
    -L "127.0.0.1:${lport}:127.0.0.1:${rport}" "$host"
  echo "$lport" >"$PORTFILE"
  echo "oc2: tunnel 127.0.0.1:$lport -> $host:$rport (close: oc2 disconnect $host)" >&2
}

case "${1:-}" in
  shell)
    shift
    if [ "${1:-}" = "--gpu" ]; then ARGS+=(--gpus all); shift; fi
    run bash "$@"
    ;;
  remote)
    shift
    url="${1:?usage: oc2 remote <url> [opencode args...]}"; shift
    # No directory argument: with --server the client would send its own cwd
    # (anomalyco/opencode#47665); the server uses its working_dir instead.
    run opencode --server "$url" "$@"
    ;;
  connect)
    shift
    host="${1:?usage: oc2 connect <ssh-host> [remote-port]}"
    rport="${2:-4096}"
    tunnel_up "$host" || tunnel_start "$host" "$rport"
    run opencode --server "http://127.0.0.1:$(cat "$PORTFILE")"
    ;;
  disconnect)
    shift
    host="${1:?usage: oc2 disconnect <ssh-host>}"
    tunnel_paths "$host"
    if tunnel_up "$host"; then
      ssh -S "$SOCK" -O exit "$host" 2>/dev/null || true
      echo "oc2: tunnel to $host closed" >&2
    else
      echo "oc2: no tunnel to $host" >&2
    fi
    rm -f "$PORTFILE"
    ;;
  *)
    run opencode --standalone "$@"
    ;;
esac
